<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rabbitHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="My Rabbits"
            android:textColor="#4A3020"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnAddRabbitHeader"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_add_button_orange"
            android:contentDescription="Add new rabbit"
            android:padding="12dp"
            android:src="@drawable/ic_add"
            app:tint="@color/white" />

    </LinearLayout>

    <EditText
        android:id="@+id/editSearchRabbit"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/rabbit_input_bg"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="10dp"
        android:hint="Search rabbits"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/black"
        android:textColorHint="#77705F"
        android:textSize="14sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerRabbits"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="20dp"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="30dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginBottom="20dp"
                android:contentDescription="No rabbits"
                android:src="@drawable/ic_pets" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:text="No rabbits yet"
                android:textColor="#4A3020"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="Add your first rabbit to start tracking their health and get personalized care tips."
                android:textColor="#B69A70"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnAddFirstRabbit"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:background="@drawable/button_register_bg"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:stateListAnimator="@null"
                android:text="Add your first rabbit"
                android:textAllCaps="false"
                android:textColor="#4A3020"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/noResultsState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="30dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="No rabbits match your search"
                android:textColor="#4A3020"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/fabAddRabbit"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="24dp"
            android:background="@drawable/button_register_bg"
            android:contentDescription="Add new rabbit"
            android:elevation="6dp"
            android:padding="14dp"
            android:src="@drawable/ic_add"
            android:visibility="gone"
            app:tint="@color/black" />

    </FrameLayout>

</LinearLayout>