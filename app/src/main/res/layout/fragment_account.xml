<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header / Logo -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <ImageView
                android:id="@+id/menuIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="10dp"
                android:contentDescription="Menu"
                android:src="@drawable/menu"
                app:tint="@color/Orangie" />

            <ImageView
                android:id="@+id/profileImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_centerHorizontal="true"
                android:background="@drawable/profile_border_bg"
                android:clickable="true"
                android:contentDescription="Profile photo"
                android:focusable="true"
                android:padding="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/account_user" />

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">

            <EditText
                android:id="@+id/accountFirstName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/edittext_bg"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:hint="First Name"
                android:paddingHorizontal="18dp"
                android:textColor="@color/black"
                android:textColorHint="#666666"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/accountLastName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/edittext_bg"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:hint="Last Name"
                android:paddingHorizontal="18dp"
                android:textColor="@color/black"
                android:textColorHint="#666666"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/accountUsername"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/edittext_bg"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:hint="Username"
                android:paddingHorizontal="18dp"
                android:textColor="@color/black"
                android:textColorHint="#666666"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/accountEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/edittext_bg"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="18dp"
                android:textColor="@color/black"
                android:textColorHint="#666666"
                android:textSize="15sp" />

            <AutoCompleteTextView
                android:id="@+id/accountBreed"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/edittext_bg"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:hint="Breed"
                android:inputType="none"
                android:paddingHorizontal="18dp"
                android:textColor="@color/black"
                android:textColorHint="#666666"
                android:textSize="15sp" />

            <AutoCompleteTextView
                android:id="@+id/accountStatus"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/edittext_bg"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:hint="Status"
                android:inputType="none"
                android:paddingHorizontal="18dp"
                android:textColor="@color/black"
                android:textColorHint="#666666"
                android:textSize="15sp" />

            <AutoCompleteTextView
                android:id="@+id/accountRole"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/edittext_bg"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:hint="Role"
                android:inputType="none"
                android:paddingHorizontal="18dp"
                android:textColor="@color/black"
                android:textColorHint="#666666"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_register_bg"
                    android:backgroundTint="@null"
                    android:text="Save Changes"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnDiscard"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/card_bg"
                    android:backgroundTint="@null"
                    android:elevation="2dp"
                    android:text="Discard"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>