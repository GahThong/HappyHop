<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:elevation="1dp">

        <ImageView
            android:id="@+id/imgRabbit"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bunny"
            android:contentDescription="Rabbit photo"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtRabbitName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rabbit Name"
                android:textColor="#4A3020"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtRabbitBreedAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Breed · Age"
                android:textColor="#B69A70"
                android:textSize="13sp" />

        </LinearLayout>

        <View
            android:id="@+id/statusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_status_dot" />

    </LinearLayout>

    <ImageView
        android:id="@+id/imgQrBadge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:contentDescription="QR uploaded"
        android:src="@drawable/ic_qr_placeholder"
        android:visibility="gone" />

</FrameLayout>