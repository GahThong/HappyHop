<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:padding="12dp"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgRabbit"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/card_bg"
                android:contentDescription="Rabbit photo"
                android:padding="4dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/txtRabbitName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="Rabbit Name"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="normal" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnEditRabbit"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="14dp"
                android:background="@android:color/transparent"
                android:contentDescription="Edit"
                android:src="@drawable/ic_edit" />



            <ImageButton
                android:id="@+id/btnDeleteRabbit"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@android:color/transparent"
                android:contentDescription="Delete"
                android:src="@drawable/ic_delete"
                app:tint="@color/delete_red" />

        </LinearLayout>

    </LinearLayout>

    <!-- QR badge shown only if vet records QR was uploaded (toggle visibility in adapter) -->
    <ImageView
        android:id="@+id/imgQrBadge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:contentDescription="QR uploaded"
        android:src="@drawable/ic_qr_placeholder"
        android:visibility="gone" />

</FrameLayout>