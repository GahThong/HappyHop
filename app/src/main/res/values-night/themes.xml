<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.BunnyCare" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Keep same behavior in dark mode -->
        <item name="colorOnSurface">@android:color/black</item>
        <item name="colorOnSurfaceVariant">@android:color/black</item>

        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="android:textColorSecondary">@android:color/black</item>

        <item name="colorSurface">@android:color/white</item>
        <item name="android:colorBackground">@android:color/white</item>

        <!-- Remove Material3 default purple -->
        <item name="colorPrimary">@color/cream_bg</item>
        <item name="colorOnPrimary">@android:color/black</item>
        <item name="colorPrimaryContainer">@color/brownie_cream</item>
        <item name="colorOnPrimaryContainer">@android:color/black</item>

        <item name="colorSecondary">@color/Orangie</item>
        <item name="colorOnSecondary">@android:color/black</item>
        <item name="colorSecondaryContainer">@color/mint</item>
        <item name="colorOnSecondaryContainer">@android:color/black</item>

    </style>

    <style name="Theme.BunnyCare" parent="Base.Theme.BunnyCare">

        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

    </style>
</resources>